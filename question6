library(ggplot2)
library(dplyr)
library(emmeans)

### loading data
crickets <- data.frame(
  species = c(
    rep("O. exclamationis", 14),
    rep("O. niveus", 17)
  ),
  temp = c(
    # O. exclamationis
    20.8, 20.8, 24.0, 24.0, 24.0, 24.0,
    26.2, 26.2, 26.2, 26.2,
    28.4, 29.0, 30.4, 30.4,
    # O. niveus
    17.2, 18.3, 18.3, 18.3, 18.9, 18.9,
    20.4, 21.0, 21.0, 22.1, 23.5, 24.2,
    25.9, 26.5, 26.5, 26.5, 28.6
  ),
  pulse = c(
    # O. exclamationis
    67.9, 65.1, 77.3, 78.7, 79.4, 80.4,
    85.8, 86.6, 87.5, 89.1,
    98.6, 100.8, 99.3, 101.7,
    # O. niveus
    44.3, 47.2, 47.6, 49.6, 50.3, 51.8,
    60.0, 58.5, 58.9, 60.7, 69.8, 70.9,
    76.2, 76.1, 77.0, 77.7, 84.7
  )
)
### making species a factor
crickets$species <- as.factor(crickets$species)

# gonna do ANCOVA b/c continuous response and continuous and categorical pred

# just checking relationship b/t temp and pulse b/t species
ggplot(crickets, aes(x = temp, y = pulse, color = species)) +
  geom_point(size = 3) +
  geom_smooth(method = "lm", se = TRUE)
# looks like pulse increases w/ temp and slopes b/t species are parallel

### checking assumptions
## full model w/ interaction
ancova_interaction <- lm(pulse ~ species * temp, data = crickets)

## normality
par(mfrow = c(1, 2), mar = c(4, 4, 3, 1))
qqnorm(residuals(ancova_interaction))
qqline(residuals(ancova_interaction), col = "red", lwd = 2)
hist(residuals(ancova_interaction))

## heteroscedasticity
plot(fitted(ancova_interaction), residuals(ancova_interaction))
abline(h = 0, col = "red", lty = 2, lwd = 2)
# looking pretty good

## homogeneity of slopes
summary(ancova_interaction)
anova(ancova_interaction)
# species x temp is not sig = slopes are parallel 
# drop interaction b/c not sig

### fitting final model
ancova_final <- lm(pulse ~ species + temp, data = crickets)
summary(ancova_final)
anova(ancova_final)

summary(ancova_final)$r.squared
summary(ancova_final)$adj.r.squared

## estimated marginal means
emm <- emmeans(ancova_final, ~ species)
summary(emm)
